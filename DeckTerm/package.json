{
  "name": "deck-term",
  "version": "0.6.0",
  "main": "out/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "compile": "tsc",
    "watch": "tsc --watch",
    "start": "tsc && electron .",
    "dist": "tsc && electron-builder"
  },
  "keywords": [],
  "author": "Cedric Fromm",
  "build": {
    "appId": "com.cedfro.deck-term",
    "productName": "DeckTerm",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "out/**/*",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "build/DeckTerm.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/DeckTerm.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build"
    }
  },
  "license": "ISC",
  "description": "Electron Terminal controllable using StreamDeck",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/ws": "^8.18.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "typescript": "^5.9.3"
  }
}
